{
  "version": 1,
  "weights": { "econ": 0.35, "geo": 0.35, "nat": 0.15, "bio_infra": 0.15 },

  "booster": {
    "max1_threshold": 70,
    "max2_threshold": 45,
    "factor": 0.65,
    "exponent": 1.3,
    "isolated_cap": 15
  },

  "bands": [
    { "key": "low",      "min": 0,  "max": 20,  "label_th": "ผลกระทบเชิงระบบระดับต่ำ",         "color": "green" },
    { "key": "watch",    "min": 21, "max": 45,  "label_th": "เฝ้าระวัง / ผันผวนระดับภูมิภาค",     "color": "yellow" },
    { "key": "high",     "min": 46, "max": 70,  "label_th": "ตึงเครียดสูง / กระทบห่วงโซ่โลก",      "color": "orange" },
    { "key": "critical", "min": 71, "max": 100, "label_th": "วิกฤตเชิงระบบระดับโลก",             "color": "red" }
  ],

  "freshness": {
    "market_max_age_hours": 96,
    "pillar_last_valid_max_age_hours": 72,
    "history_days": 90
  },

  "econ": {
    "trading_days_window": 5,
    "indicators": {
      "vix": {
        "label_th": "ดัชนีความผันผวน VIX",
        "ticker": "^VIX", "fred": "VIXCLS", "unit": "จุด",
        "weight": 0.30,
        "combine": "max",
        "level_points":   [[12, 0], [15, 10], [20, 30], [25, 50], [30, 65], [40, 85], [55, 100]],
        "change_points":  [[0, 0], [15, 10], [30, 35], [60, 70], [100, 100]]
      },
      "brent": {
        "label_th": "น้ำมันดิบ Brent",
        "ticker": "BZ=F", "fred": "DCOILBRENTEU", "unit": "USD/บาร์เรล",
        "weight": 0.25,
        "combine": "max",
        "level_points":   [[60, 5], [75, 12], [90, 30], [110, 55], [130, 80], [150, 100]],
        "change_points":  [[0, 0], [4, 15], [8, 40], [15, 70], [25, 100]],
        "change_abs": true
      },
      "gold": {
        "label_th": "ทองคำ (Safe Haven)",
        "ticker": "GC=F", "fred": null, "unit": "USD/ออนซ์",
        "weight": 0.10,
        "combine": "change_only",
        "change_points":  [[0, 5], [2, 20], [4, 45], [7, 75], [10, 100]]
      },
      "spx": {
        "label_th": "ดัชนี S&P 500",
        "ticker": "^GSPC", "fred": "SP500", "unit": "จุด",
        "weight": 0.20,
        "combine": "max",
        "change_points":   [[-20, 100], [-12, 80], [-7, 55], [-4, 30], [-2, 12], [0, 0]],
        "drawdown_points": [[-35, 100], [-20, 75], [-12, 45], [-7, 20], [-3, 5], [0, 0]]
      },
      "soxx": {
        "label_th": "ดัชนีเซมิคอนดักเตอร์ SOXX",
        "ticker": "SOXX", "fred": null, "unit": "USD",
        "weight": 0.15,
        "combine": "max",
        "change_points":   [[-25, 100], [-15, 75], [-9, 45], [-5, 20], [-2, 5], [0, 0]],
        "drawdown_points": [[-45, 100], [-30, 70], [-18, 40], [-10, 15], [0, 0]]
      }
    }
  },

  "events": {
    "decay_per_day": 0.15,
    "drop_below": 5,
    "max_age_days": 30,
    "aggregate_tail_weight": 0.5,
    "corroboration": { "1": 0.6, "2": 0.8, "3": 1.0 },
    "headline_only_min_severity": 70,
    "new_event_min_score": 30
  },

  "geo": {
    "categories": [
      { "id": "nuclear",        "severity": 95, "label_th": "ภัยคุกคามนิวเคลียร์",
        "any": ["nuclear strike", "nuclear attack", "nuclear weapon", "nuclear test", "tactical nuke", "nuclear threat", "radiological"] },
      { "id": "great_power",    "severity": 90, "label_th": "การปะทะของมหาอำนาจ",
        "powers_min": 2,
        "any": ["clash", "fired on", "shoot down", "shot down", "strike", "attack", "collision", "confrontation", "skirmish"] },
      { "id": "chokepoint",     "severity": 85, "label_th": "การปิด/คุกคามช่องแคบเดินเรือ",
        "any": ["blockade", "strait closed", "closes strait", "close the strait", "shipping halted", "shipping suspended", "tanker seized", "tanker attacked", "tankers hit", "tanker hit", "tankers attacked", "ships attacked", "red sea attack", "naval blockade"],
        "or_all": [["hormuz", "attack"], ["hormuz", "close"], ["hormuz", "hit"], ["hormuz", "tanker"], ["hormuz", "mine"], ["malacca", "block"], ["suez", "block"], ["taiwan strait", "blockade"], ["bab el-mandeb", "attack"], ["red sea", "shipping"]] },
      { "id": "energy_infra",   "severity": 75, "label_th": "การโจมตีโครงสร้างพื้นฐานพลังงาน",
        "or_all": [["refinery", "attack"], ["refinery", "strike"], ["refinery", "drone"], ["oil facility", "attack"], ["pipeline", "sabotage"], ["pipeline", "attack"], ["power grid", "attack"], ["power plant", "strike"], ["gas field", "attack"], ["oil terminal", "strike"], ["energy infrastructure", "strike"], ["energy infrastructure", "attack"]] },
      { "id": "invasion",       "severity": 80, "label_th": "การรุกรานหรือประกาศสงคราม",
        "any": ["invasion", "invades", "declares war", "declaration of war", "full-scale war", "ground offensive", "annexation", "annexes"] },
      { "id": "missile_strike", "severity": 55, "label_th": "การโจมตีทางอากาศ/ขีปนาวุธ",
        "any": ["missile", "airstrike", "air strike", "air raid", "drone strike", "ballistic", "bombardment", "shelling", "rocket attack"] },
      { "id": "mobilization",   "severity": 45, "label_th": "การเคลื่อนกำลังพล",
        "any": ["troop buildup", "troops massing", "mobilisation", "mobilization", "military drills", "war games", "deploys troops", "military exercise", "carrier strike group"] },
      { "id": "sanctions",      "severity": 40, "label_th": "มาตรการคว่ำบาตร/สงครามการค้า",
        "any": ["sanction", "export ban", "export controls", "embargo", "tariff", "trade war", "asset freeze"] },
      { "id": "coup_unrest",    "severity": 35, "label_th": "รัฐประหาร/ความไม่สงบทางการเมือง",
        "any": ["coup", "martial law", "state of emergency", "insurrection", "civil war"] },
      { "id": "terror",         "severity": 35, "label_th": "การก่อการร้าย",
        "any": ["terror attack", "terrorist attack", "suicide bomb", "bombing kills", "gunmen kill"] },
      { "id": "conflict",       "severity": 30, "label_th": "การสู้รบ/ความขัดแย้งด้วยอาวุธ",
        "any": ["killed in", "fighting", "ceasefire", "offensive", "troops", "militants", "rebels", "insurgent", "war"] }
    ],
    "great_powers": ["united states", "china", "russia", "nato"],
    "gdelt": {
      "query": "(military OR missile OR airstrike OR blockade OR sanctions OR invasion OR \"nuclear\" OR troops) sourcelang:english",
      "timespan": "24h",
      "maxrecords": 75
    },
    "rss": [
      { "name": "BBC World",  "url": "https://feeds.bbci.co.uk/news/world/rss.xml" },
      { "name": "Al Jazeera", "url": "https://www.aljazeera.com/xml/rss/all.xml" },
      { "name": "Reuters (Google News)", "url": "https://news.google.com/rss/search?q=when:1d+source:Reuters+world&hl=en-US&gl=US&ceid=US:en" }
    ],
    "max_article_age_hours": 48
  },

  "nat": {
    "local_cap": 30,
    "hub_radius_km": 300,
    "event_window_days": 7,
    "min_magnitude": 6.0,
    "magnitude_points": [[6.0, 5], [6.5, 12], [7.0, 25], [7.5, 45], [8.0, 65], [8.5, 85], [9.0, 100]],
    "pager_floor": { "yellow": 35, "orange": 60, "red": 80 },
    "gdacs_alert_points": { "green": 3, "orange": 45, "red": 75 },
    "gdacs_red_multicountry": 85,
    "tsunami_cross_region_min_mag": 7.5,
    "strategic_hubs": [
      { "id": "taiwan_strait", "name_th": "ช่องแคบไต้หวัน",   "lat": 24.0,  "lon": 119.5 },
      { "id": "suez",          "name_th": "คลองสุเอซ",        "lat": 30.6,  "lon": 32.3 },
      { "id": "hormuz",        "name_th": "ช่องแคบฮอร์มุซ",    "lat": 26.6,  "lon": 56.3 },
      { "id": "malacca",       "name_th": "ช่องแคบมะละกา",    "lat": 2.5,   "lon": 101.0 },
      { "id": "tokyo",         "name_th": "โตเกียว",          "lat": 35.68, "lon": 139.69 },
      { "id": "panama",        "name_th": "คลองปานามา",       "lat": 9.08,  "lon": -79.68 },
      { "id": "bab_el_mandeb", "name_th": "ช่องแคบบับเอลมันเดบ", "lat": 12.6,  "lon": 43.3 },
      { "id": "shanghai",      "name_th": "เซี่ยงไฮ้",         "lat": 31.23, "lon": 121.47 }
    ],
    "gdacs_type_th": { "EQ": "แผ่นดินไหว", "TC": "พายุหมุนเขตร้อน", "FL": "อุทกภัย", "VO": "ภูเขาไฟระเบิด", "DR": "ภัยแล้ง", "WF": "ไฟป่า", "TS": "สึนามิ" }
  },

  "bio_infra": {
    "single_country_cap": 25,
    "categories": [
      { "id": "pheic",        "severity": 90, "label_th": "ภาวะฉุกเฉินด้านสาธารณสุขระหว่างประเทศ", "multi_country": true,
        "any": ["public health emergency of international concern", "pheic", "pandemic declared", "pandemic emergency"] },
      { "id": "novel_pathogen", "severity": 60, "label_th": "เชื้อโรคอุบัติใหม่",
        "any": ["novel virus", "novel coronavirus", "human-to-human transmission", "unknown disease", "disease x", "new strain"] },
      { "id": "high_consequence", "severity": 45, "label_th": "โรคติดต่อร้ายแรง",
        "any": ["ebola", "marburg", "avian influenza", "h5n1", "mers", "nipah", "plague", "mpox clade i", "lassa", "cholera"] },
      { "id": "outbreak",     "severity": 25, "label_th": "การระบาดของโรค",
        "any": ["outbreak", "epidemic", "disease outbreak news", "cases reported"] },
      { "id": "global_outage", "severity": 70, "label_th": "ระบบล่มหลายประเทศ", "multi_country": true,
        "any": ["global outage", "worldwide outage", "global it outage", "internet outage across", "undersea cable cut", "subsea cable"] },
      { "id": "cyber_incident", "severity": 40, "label_th": "การโจมตีไซเบอร์ที่เกิดขึ้นจริง",
        "any": ["ransomware attack", "cyberattack", "cyber attack", "actively exploited", "#stopransomware", "compromise of", "breach of", "hackers", "malicious cyber activity"] },
      { "id": "vuln_advisory", "severity": 5, "label_th": "ประกาศเตือนช่องโหว่ทั่วไป",
        "any": ["ics advisory", "vulnerability", "vulnerabilities", "cve", "releases", "security update", "known exploited vulnerabilities"] }
    ],
    "multi_country_markers": ["multi-country", "multiple countries", "several countries", "international partners", "global", "worldwide", "across europe", "across asia", "across africa", "regional spread"],
    "who_api": "https://www.who.int/api/news/diseaseoutbreaknews?$orderby=PublicationDateAndTime%20desc&$top=20",
    "who_rss": "https://www.who.int/rss-feeds/news-english.xml",
    "cisa_rss": "https://www.cisa.gov/cybersecurity-advisories/all.xml",
    "window_days": 14
  },

  "ai": {
    "econ_delta_threshold": 3,
    "max_headlines": 20
  }
}
